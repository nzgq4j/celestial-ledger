<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme: navy window so no white flash appears behind the WebView. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/atlas_navy</item>
        <item name="colorPrimaryDark">@color/atlas_navy</item>
        <item name="colorAccent">@color/atlas_gold</item>
        <item name="android:windowBackground">@color/atlas_navy</item>
        <item name="android:statusBarColor">@color/atlas_navy</item>
        <item name="android:navigationBarColor">@color/atlas_navy_deep</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!-- Cold-start splash: static navy background with the gold astrolabe mark. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/atlas_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
