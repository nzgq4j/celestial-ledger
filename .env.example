# Server-only. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_REPORT_MODEL=gpt-5-mini
OPENAI_INTERPRETATION_MODEL=gpt-5-mini
# Server-only reCAPTCHA secret. The public site key is managed in Administration.
RECAPTCHA_SECRET_KEY=
# Optional identification for Nominatim's usage policy.
NOMINATIM_USER_AGENT=CelestialAtlas/1.0 (contact@example.com)

# Supabase public project configuration. Use the modern publishable key.
# Vercel Supabase Marketplace names (preferred in hosted environments)
NEXT_PUBLIC_STORAGE_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_STORAGE_SUPABASE_ANON_KEY=replace_me
STORAGE_SUPABASE_SECRET_KEY=

# Local aliases are also supported. The app normalizes these at build time.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Set true only in Preview/demo environments to disable production data access.
NEXT_PUBLIC_DEMO_MODE=false

# Server-only Supabase key. Use sb_secret_ (or legacy service_role during migration).
SUPABASE_SECRET_KEY=

# Stripe server configuration. Test-mode values only until launch approval.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Canonical public application origin used for Checkout redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Tarot remains unavailable until deck content and access policy are approved.
TAROT_READING_ENABLED=false

# Server-only contact notification delivery over authenticated TLS SMTP.
MAIL_HOST=mail.celestialatlas.app
MAIL_PORT=465
MAIL_USER=support
MAIL_PWD=
MAIL_FROM=Celestial Atlas Support <support@celestialatlas.app>
