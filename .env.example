# Server-only. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional identification for Nominatim's usage policy.
NOMINATIM_USER_AGENT=CelestialAtlas/1.0 (contact@example.com)

# Supabase public project configuration. Use the modern publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Set true only in Preview/demo environments to disable production data access.
NEXT_PUBLIC_DEMO_MODE=false

# Server-only Supabase key. Use sb_secret_ (or legacy service_role during migration).
SUPABASE_SECRET_KEY=

# Stripe server configuration. Test-mode values only until launch approval.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Canonical public application origin used for Checkout redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
