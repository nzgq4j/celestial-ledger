{
  "name": "celestial-atlas",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:app && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ephemeris-server": "node scripts/check-ephemeris-server.mjs",
    "licenses": "node scripts/check-licenses.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm --prefix celestial-atlas test && npm run build",
    "build:app": "npm --prefix celestial-atlas ci --no-audit --no-fund && npm --prefix celestial-atlas run build && node scripts/copy-app.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "astronomy-engine": "2.1.19",
    "next": "16.4.6",
    "nodemailer": "^10.6.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "22.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "postcss": "8.5.25"
  }
}
